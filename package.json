{
  "name": "metalflow-os",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "pnpm --filter @metalflow/web build && tsc --noEmit",
    "typecheck": "tsc --noEmit && pnpm --filter @metalflow/web typecheck",
    "test": "vitest run",
    "db:generate": "prisma generate --schema packages/database/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema packages/database/prisma/schema.prisma",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages tests scripts",
    "lint": "eslint apps packages tests"
  },
  "dependencies": {
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/platform-express": "^12.3.2",
    "@nestjs/swagger": "^12.0.5",
    "@prisma/client": "^6.19.3",
    "better-auth": "^1.7.14",
    "bullmq": "^6.5.0",
    "decimal.js": "^10.6.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "multer": "^2.5.0",
    "nodemailer": "^10.2.1",
    "openai": "^7.45.1",
    "pdfkit": "^0.20.2",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "eslint": "^9.39.5",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
