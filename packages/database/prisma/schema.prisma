generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
  memberships Membership[]
  @@map("user")
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  @@map("session")
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@map("account")
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
  @@map("verification")
}
model Organization {
  id String @id @default(uuid())
  name String
  currency String @default("USD")
  country String @default("US")
  businessType String @default("DISTRIBUTOR")
  locale String @default("en")
  modules String[] @default(["sales","inventory","procurement","projects","finance","fabrication","ai","takeoff"])
  settings Json @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  memberships Membership[]
}
model Membership {
  id String @id @default(uuid())
  userId String
  organizationId String
  role String @default("VIEWER")
  user User @relation(fields:[userId],references:[id],onDelete:Cascade)
  organization Organization @relation(fields:[organizationId],references:[id],onDelete:Cascade)
  @@unique([organizationId,userId])
}
model Invitation {
  id String @id @default(uuid())
  organizationId String
  email String
  role String
  tokenHash String @unique
  expiresAt DateTime
  acceptedAt DateTime?
  createdBy String
  createdAt DateTime @default(now())
  @@index([organizationId,email])
}
model Customer {
  id String @id @default(uuid())
  organizationId String
  name String
  email String?
  phone String?
  type String @default("BUSINESS")
  address String?
  notes String?
  tags String[] @default([])
  creditLimit Decimal @default(0) @db.Decimal(18,2)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId,id])
  @@index([organizationId,name])
}
model Product {
  id String @id @default(uuid())
  organizationId String
  sku String
  name String
  material String
  grade String?
  profile String
  unit String @default("piece")
  specifications Json @default("{}")
  cost Decimal @default(0) @db.Decimal(18,4)
  price Decimal @db.Decimal(18,4)
  reorderPoint Decimal @default(0) @db.Decimal(18,4)
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId,sku])
  @@unique([organizationId,id])
  @@index([organizationId,name])
}
model Inquiry {
  id String @id @default(uuid())
  organizationId String
  customerId String
  subject String
  source String @default("MANUAL")
  text String
  status String @default("NEW")
  extraction Json?
  reviewed Boolean @default(false)
  requestedDate DateTime?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId,id])
  @@index([organizationId,status])
}
model Document {
  id String @id @default(uuid())
  organizationId String
  kind String
  number String
  customerId String?
  supplierId String?
  inquiryId String?
  sourceId String?
  status String @default("DRAFT")
  currency String
  version Int @default(1)
  validUntil DateTime?
  dueDate DateTime?
  notes String @default("")
  subtotal Decimal @db.Decimal(18,2)
  discount Decimal @default(0) @db.Decimal(18,2)
  taxRate Decimal @default(0) @db.Decimal(8,4)
  tax Decimal @default(0) @db.Decimal(18,2)
  total Decimal @db.Decimal(18,2)
  paid Decimal @default(0) @db.Decimal(18,2)
  lines Json
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId,number])
  @@unique([organizationId,id])
  @@unique([organizationId,kind,sourceId])
  @@index([organizationId,kind,status,createdAt])
}
model DocumentVersion {
  id String @id @default(uuid())
  organizationId String
  documentId String
  version Int
  snapshot Json
  createdBy String
  createdAt DateTime @default(now())
  @@unique([documentId,version])
  @@index([organizationId,documentId])
}
model Warehouse {
  id String @id @default(uuid())
  organizationId String
  name String
  address String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId,id])
}
model InventoryBalance {
  id String @id @default(uuid())
  organizationId String
  productId String
  warehouseId String
  onHand Decimal @default(0) @db.Decimal(18,4)
  reserved Decimal @default(0) @db.Decimal(18,4)
  updatedAt DateTime @updatedAt
  @@unique([organizationId,productId,warehouseId])
  @@index([organizationId,warehouseId])
}
model InventoryMovement {
  id String @id @default(uuid())
  organizationId String
  productId String
  warehouseId String
  quantity Decimal @db.Decimal(18,4)
  kind String
  reference String
  createdBy String
  createdAt DateTime @default(now())
  @@index([organizationId,createdAt])
}
model Reservation {
  id String @id @default(uuid())
  organizationId String
  orderId String
  productId String
  warehouseId String
  quantity Decimal @db.Decimal(18,4)
  fulfilled Decimal @default(0) @db.Decimal(18,4)
  @@unique([organizationId,orderId,productId,warehouseId])
}
model Supplier {
  id String @id @default(uuid())
  organizationId String
  name String
  email String?
  phone String?
  address String?
  notes String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId,id])
}
model GoodsReceipt {
  id String @id @default(uuid())
  organizationId String
  purchaseId String
  warehouseId String
  lines Json
  idempotencyKey String
  createdBy String
  createdAt DateTime @default(now())
  @@unique([organizationId,idempotencyKey])
  @@index([organizationId,purchaseId])
}
model Project {
  id String @id @default(uuid())
  organizationId String
  customerId String
  name String
  address String?
  status String @default("PLANNING")
  budget Decimal @db.Decimal(18,2)
  dueDate DateTime?
  notes String?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId,id])
  @@index([organizationId,status])
}
model Task {
  id String @id @default(uuid())
  organizationId String
  projectId String?
  name String
  status String @default("TODO")
  assignedTo String?
  dueDate DateTime?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId,projectId])
}
model Expense {
  id String @id @default(uuid())
  organizationId String
  projectId String?
  name String
  category String
  amount Decimal @db.Decimal(18,2)
  date DateTime
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId,date])
}
model Payment {
  id String @id @default(uuid())
  organizationId String
  invoiceId String
  amount Decimal @db.Decimal(18,2)
  reference String
  method String
  idempotencyKey String
  createdBy String
  createdAt DateTime @default(now())
  @@unique([organizationId,idempotencyKey])
  @@index([organizationId,invoiceId])
}
model FabricationJob {
  id String @id @default(uuid())
  organizationId String
  name String
  orderId String?
  status String @default("PLANNED")
  notes String?
  cutPlan Json?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId,status])
}
model Takeoff {
  id String @id @default(uuid())
  organizationId String
  name String
  projectId String?
  fileId String?
  scale Decimal @default(1) @db.Decimal(18,6)
  measurements Json @default("[]")
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId,projectId])
}
model FileAsset {
  id String @id @default(uuid())
  organizationId String
  name String
  mime String
  size Int
  path String
  createdBy String
  createdAt DateTime @default(now())
  @@index([organizationId,createdAt])
}
model AIJob {
  id String @id @default(uuid())
  organizationId String
  kind String
  status String @default("QUEUED")
  input Json
  result Json?
  error String?
  model String?
  usage Json?
  createdBy String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([organizationId,createdAt])
}
model AuditLog {
  id String @id @default(uuid())
  organizationId String
  actorId String
  action String
  entityId String
  detail Json @default("{}")
  createdAt DateTime @default(now())
  @@index([organizationId,createdAt])
}

model Fulfillment {
  id String @id @default(uuid())
  organizationId String
  orderId String
  warehouseId String
  lines Json
  idempotencyKey String
  status String
  createdBy String
  createdAt DateTime @default(now())
  @@unique([organizationId,idempotencyKey])
  @@index([organizationId,orderId])
}

model StockTransfer {
 id String @id @default(uuid())
 organizationId String
 productId String
 fromWarehouseId String
 toWarehouseId String
 quantity Decimal @db.Decimal(18,4)
 reason String
 idempotencyKey String
 createdBy String
 createdAt DateTime @default(now())
 @@unique([organizationId,idempotencyKey])
 @@index([organizationId,createdAt])
}

model ImportBatch {
 id String @id @default(uuid())
 organizationId String
 resource String
 requestHash String
 idempotencyKey String
 count Int
 createdBy String
 createdAt DateTime @default(now())
 @@unique([organizationId,idempotencyKey])
}
model ProjectChangeOrder {
 id String @id @default(uuid())
 organizationId String
 projectId String
 name String
 reason String
 amount Decimal @db.Decimal(18,2)
 status String @default("DRAFT")
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([organizationId,projectId])
}

model CommercialCost {
 id String @id @default(uuid())
 organizationId String
 documentId String @unique
 totalCost Decimal @db.Decimal(18,2)
 complete Boolean
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([organizationId,documentId])
}

model AIProvider {
 id String @id @default(uuid())
 organizationId String
 name String
 type String
 protocol String @default("RESPONSES")
 baseUrl String
 textModel String?
 imageModel String?
 enabled Boolean @default(true)
 priority Int @default(0)
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 keys AIProviderKey[]
 @@unique([organizationId,id])
 @@index([organizationId,enabled,priority])
}
model AIProviderKey {
 id String @id @default(uuid())
 organizationId String
 providerId String
 provider AIProvider @relation(fields:[organizationId,providerId],references:[organizationId,id])
 label String
 encryptedKey String
 fingerprint String
 suffix String
 enabled Boolean @default(true)
 status String @default("READY")
 dailyRequestLimit Int?
 dailyTokenLimit Int?
 usageDay String
 dailyRequests Int @default(0)
 dailyTokens Int @default(0)
 totalRequests Int @default(0)
 totalTokens BigInt @default(0)
 lastUsedAt DateTime?
 cooldownUntil DateTime?
 leaseUntil DateTime?
 leaseId String?
 lastErrorCode String?
 lastHttpStatus Int?
 createdBy String
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@unique([organizationId,providerId,fingerprint])
 @@index([organizationId,providerId,enabled])
}
model AIKeyAttempt {
 id String @id @default(uuid())
 organizationId String
 jobId String
 providerId String
 keyId String
 model String
 status String @default("RUNNING")
 httpStatus Int?
 errorCode String?
 inputTokens Int @default(0)
 outputTokens Int @default(0)
 totalTokens Int @default(0)
 createdAt DateTime @default(now())
 completedAt DateTime?
 @@index([organizationId,createdAt])
 @@index([organizationId,jobId])
}
